# SMTP (Gmail: use an App Password, not your normal password)
# Supports either SMTP_* or EMAIL_* names
SMTP_USER=
SMTP_PASS=
# EMAIL_USER=
# EMAIL_PASS=

# Optional: defaults to Gmail
# SMTP_SERVICE=gmail

# Optional: defaults to SMTP_USER / EMAIL_USER (must match sender for Gmail)
# SMTP_FROM=

# Inbox for contact form notifications
CONTACT_EMAIL=
